# Copie este arquivo para .env e ajuste os valores para o seu ambiente.
# Nunca faça commit do arquivo .env.

# Servidor de tracking do MLflow ou backend local.
# Local: sqlite:///mlflow.db | Docker Compose: http://mlflow-server:5000
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=purchase-intention

# Nome com que o melhor modelo será registrado no Model Registry.
MLFLOW_REGISTERED_MODEL_NAME=purchase-intention-classifier

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
